// Release signs by hand with Developer ID, for builds handed out outside the
// Mac App Store. It never reads Local.xcconfig, so a personal Apple
// Development setup can't end up in a release. `make release` passes the team
// as LANES_TEAM_ID; a plain Release build without it only works with signing
// turned off (CI builds with CODE_SIGNING_ALLOWED=NO).
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application
DEVELOPMENT_TEAM = $(LANES_TEAM_ID)
// Notarization rejects signatures without a secure timestamp.
OTHER_CODE_SIGN_FLAGS = --timestamp
