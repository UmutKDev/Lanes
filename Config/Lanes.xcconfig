// Shared build settings for the Lanes app.
//
// Signing is ad hoc ("Sign to Run Locally") unless Local.xcconfig sets a team.
// Copy Local.xcconfig.example to Local.xcconfig and fill in your team ID; git
// ignores the copy. With a team, macOS remembers Lanes's Automation permission
// across rebuilds.
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
