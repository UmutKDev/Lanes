            "value": "Spotlight index"
          }
        }
      }
    },
    "Spotlight'ta aranabilsin diye macOS'un arama dizinine yazılır. Hesap kaldırılınca ya da adı değişince dizin yenilenir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Written to the macOS search index so it can be found in Spotlight. The index is updated when an account is removed or renamed."
