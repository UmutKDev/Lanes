            "state": "translated",
            "value": "Show Menu Bar Panel"
          }
        }
      }
    },
    "Menü Çubuğu ve Dock": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu Bar and Dock"
          }
        }
      }
    },
    "Menü çubuğu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu bar"
          }
        }
      }
    },
    "Menü çubuğu paneli": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu bar panel"
          }
        }
      }
    },
    "Menü çubuğu simgesi ve Kullanım sayfası için yalnız öndeki uygulamanın süreç numarasına bakılır. Menü çubuğu ayarı yalnız simgedeki gösterimi kapatır, süre yine sayılır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the menu bar icon and the Usage page, only the frontmost app's process ID is checked. The menu bar setting only hides the display in the icon; time is still counted."
          }
        }
      }
    },
    "Menü çubuğundayım": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm in the menu bar"
          }
        }
      }
    },
    "Metin olmadığı ya da çok büyük olduğu için atlananlar: %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipped because they aren't text or are too large: %@."
          }
        }
      }
    },
