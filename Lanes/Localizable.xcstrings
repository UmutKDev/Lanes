    },
    "Lanes'in oturum açıldığında başlaması için Sistem Ayarları > Genel > Giriş Öğeleri'nde izin ver.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To let Lanes start at login, allow it in System Settings > General > Login Items."
          }
        }
      }
    },
    "Lanes'in tanımadığı %lld Claude açık": {
      "localizations": {
        "en": {
          "variations": {
