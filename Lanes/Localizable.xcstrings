        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · When Lanes Opens"
          }
        }
      }
    },
    "%@ · bugün %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ today"
          }
        }
      }
    },
    "%@ · bugün %lld/%lld dk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld/%3$lld min today"
          }
        }
      }
    },
    "%@ öne getirilemedi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't bring %@ to the front."
          }
        }
      }
    },
    "%@, %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "%@, %@ hesabının izin verilen klasörlerinden biri değil. Hesabın Güvenlik sekmesinden ekleyebilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ isn't one of %2$@'s allowed folders. You can add it in the account's Security tab."
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@"
          }
        }
      }
    },
    "%@: Claude bitirdi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Claude Finished"
          }
        }
      }
    },
    "%@: Claude onay bekliyor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Claude Needs Approval"
          }
        }
      }
    },
    "%lld GB üstünde": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over %lld GB"
          }
        }
      }
    },
    "%lld hesabın pencere yeri kayıtlı.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Window position saved for %lld account."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Window positions saved for %lld accounts."
                }
              }
            }
          }
        }
      }
    },
    "%lld hesap açık": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld account open"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld accounts open"
                }
              }
            }
          }
        }
      }
    },
    "%lld hesap açık · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld accounts open · %2$@"
          }
        }
      }
    },
    "%lld hesap ve %lld sahne eklendi. Her hesapta yeniden giriş yapman gerekecek.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added %1$lld accounts and %2$lld scenes. You'll need to sign in to each account again."
          }
        }
      }
    },
    "%lld klasör hiçbir hesaba ait değil": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld folder doesn't belong to any account"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld folders don't belong to any account"
                }
              }
            }
          }
        }
      }
    },
    "%lld oturum": {
      "localizations": {
        "en": {
          "variations": {
