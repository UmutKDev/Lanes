    },
    "Lanes'in yazdıkları": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Lanes writes"
          }
        }
      }
    },
    "Lanes'ten Çık": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Lanes"
          }
        }
      }
    },
    "Lanes, Claude uygulamasının hesap başına bir kopyasını yapar. Her kopya Dock'ta ve Cmd-Tab'da kendi renkli simgesiyle durur ve girişini kendisi saklar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanes makes a copy of the Claude app for each account. Each copy has its own colored icon in the Dock and Cmd-Tab and keeps its own sign-in."
          }
        }
      }
    },
    "Lanes: Claude Code kurulumu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanes: Claude Code Setup"
          }
        }
      }
    },
    "Limite Takıldı": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit Reached"
          }
        }
      }
    },
    "Liste yalnız Lanes'in ayarlarında durur, klasörlerin içine bakılmaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list lives only in Lanes settings; folder contents aren't read."
          }
        }
      }
    },
