    "Hesaplar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts"
          }
        }
      }
    },
    "Hesaplar Claude'un masaüstü uygulamasında açılır. Lanes onu Uygulamalar klasöründe bulur, kopyaları ondan yapar ve asıl uygulamaya dokunmaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts open in Claude's desktop app. Lanes finds it in the Applications folder, makes copies from it and never touches the original app."
          }
        }
      }
    },
    "Hesaplar artık Claude uygulamasında kendi simgeleriyle açılıyor. Bu hesaplara bir kez yeniden giriş yapman gerekir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts now open in the Claude app with their own icons. You'll need to sign in to these accounts once more."
          }
        }
      }
    },
    "Hesaplar için gerekli. Uygulamalar klasörüne kurduğunda Lanes onu bulur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required for accounts. Once you install it in the Applications folder, Lanes finds it."
          }
        }
      }
    },
    "Hesaplar silinmez, yalnızca sahne ve kısayolu silinir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts aren't deleted; only the scene and its shortcut are."
          }
        }
      }
    },
    "Hesaplara yalnız bağlantı (symlink) eklenir; hesabın dosyaları değişmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only links (symlinks) are added to accounts; the account's files don't change."
          }
        }
      }
    },
