{
  "sourceLanguage": "tr",
  "strings": {
    "": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ""
          }
        }
      }
    },
    "\"%@\" adında bir hesap yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account named \"%@\"."
          }
        }
      }
    },
    "\"%@\" adında bir sahne yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No scene named \"%@\"."
          }
        }
      }
    },
    "\"%@\" ile eşleşen hesap yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account matches \"%@\"."
          }
        }
      }
    },
    "\"%@\" kuralı uydu (%@ uygulamasından geldi).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched rule \"%1$@\" (from %2$@)."
          }
        }
      }
    },
    "\"%@\" kuralı uydu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched rule \"%@\"."
          }
        }
      }
    },
    "\"Claude Code\" süresi tahminidir. İki süre çakışabilir, toplanmaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Claude Code\" time is an estimate. The two times can overlap, so they aren't added together."
          }
        }
      }
    },
    "\"Claude Code'u Terminalde Aç\" için gerekli.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required for \"Open Claude Code in Terminal\"."
          }
        }
      }
    },
    "\"Klasörde Aç\" yalnız bu klasörlerde çalışır. Elle başlatılan claude komutu sınırlanmaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Open in Folder\" works only in these folders. A claude command started manually isn't restricted."
          }
        }
      }
    },
    "\"Terminalde Aç\" Claude Code'u bu klasörde başlatır, seçilmezse ana klasörde.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Open in Terminal\" starts Claude Code in this folder, or in your home folder if none is chosen."
          }
        }
      }
    },
    "\"Terminalde Aç\" Claude Code'u bundan sonra bu klasörde başlatır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Open in Terminal\" will start Claude Code in this folder from now on."
          }
        }
      }
    },
    "\"Önbelleği Temizle\" yalnız Claude'un yeniden oluşturduğu önbellek klasörlerini, hesap kapalıyken ve sen onaylayınca siler.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Clear Cache\" deletes only cache folders that Claude rebuilds, only while the account is closed and only after you confirm."
          }
        }
      }
    },
    "%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ %@ kullanılmadığı için kapatıldı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ was quit because it was idle for %2$@."
          }
        }
      }
    },
    "%@ %@ saatine kadar dinleniyor ama aynı türde dinlenmeyen başka hesap yok, bağlantılar yine bu hesaba gider.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is resting until %2$@, but there's no other non-resting account of the same type, so links still go to this account."
          }
        }
      }
    },
    "%@ %@ saatine kadar dinleniyor. Bağlantılar bu sürede %@ hesabına gidecek.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is resting until %2$@. Links will go to %3$@ in the meantime."
          }
        }
      }
    },
    "%@ (%@) hesabındaki konuşmanın bir kopyası %@ (%@) hesabına geçer. İçinde müşteri ya da işveren bilgisi varsa o hesapta da durur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy of the conversation in %1$@ (%2$@) goes to %3$@ (%4$@). Any client or employer information in it will also be stored in that account."
          }
        }
      }
    },
    "%@ (arşivde)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (archived)"
          }
        }
      }
    },
    "%@ (açık)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (open)"
          }
        }
      }
    },
    "%@ (kapalı)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (closed)"
          }
        }
      }
    },
    "%@ 30 saniyedir kendi klasörüne yazmadı, Claude uygulamasının verilerini kullanıyor olabilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hasn't written to its own folder in 30 seconds and may be using the Claude app's data."
          }
        }
      }
    },
    "%@ Bir sonraki açılışta uygulanır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Takes effect at next launch."
          }
        }
      }
    },
    "%@ Lanes dışından açıldı": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was opened outside Lanes"
          }
        }
      }
    },
    "%@ Lanes'ten kaldırılsın mı?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@ from Lanes?"
          }
        }
      }
    },
    "%@ açılamadı, iletilmedi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ couldn't be opened, so the link wasn't forwarded."
          }
        }
      }
    },
    "%@ açılamadı: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open %1$@: %2$@"
          }
        }
      }
    },
    "%@ açılıyor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening %@"
          }
        }
      }
    },
    "%@ bağlandı, %@ sahnesi açılıyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ connected, opening scene %2$@."
          }
        }
      }
    },
    "%@ bağlantıları için Hesap Haritası kuralı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account Map rule for %@ links."
          }
        }
      }
    },
    "%@ boşaldı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ freed."
          }
        }
      }
    },
    "%@ bugün %@ önde kaldı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ was frontmost for %2$@ today."
          }
        }
      }
    },
    "%@ hesabına iletildi (%@ dinleniyor).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forwarded to %1$@ (%2$@ is resting)."
          }
        }
      }
    },
    "%@ hesabına iletildi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forwarded to %@."
          }
        }
      }
    },
    "%@ hesabında bu oturumun kaydı zaten var, değiştirilmedi. O hesapta Sürdür ile açabilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ already has a record of this session, so it wasn't changed. Use Continue in that account to open it."
          }
        }
      }
    },
    "%@ hesabını aç": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open %@"
          }
        }
      }
    },
    "%@ hesabının Claude Code'u beklenmeyen bir adresle (%@) giriş yapmış.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@'s Claude Code is signed in with an unexpected address (%2$@)."
          }
        }
      }
    },
    "%@ hesabının Claude Code'u beklenmeyen bir hesapla giriş yapmış. Ayrıntılar hesabın Kimlik sekmesinde.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s Claude Code is signed in with an unexpected account. See the account's Identity tab for details."
          }
        }
      }
    },
    "%@ hesabının önbelleği silinsin mi?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the cache for %@?"
          }
        }
      }
    },
    "%@ için klon hazırlanamadı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't prepare the clone for %@."
          }
        }
      }
    },
    "%@ için klon hazırlanamadı. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't prepare the clone for %1$@. %2$@"
          }
        }
      }
    },
    "%@ kaldırıldı. Claude kopyası Çöp Sepeti'nde.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was removed. Its Claude copy is in the Trash."
          }
        }
      }
    },
    "%@ kaldırıldı. Klasörü Lanes > Profiles altında, Claude kopyası Çöp Sepeti'nde.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was removed. Its folder is in Lanes > Profiles and its Claude copy is in the Trash."
          }
        }
      }
    },
    "%@ kapanmadığı için kaldırılmadı. Claude'u kapatıp yeniden dene.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wasn't removed because it didn't quit. Quit Claude and try again."
          }
        }
      }
    },
    "%@ klasörü artık yok, listeden çıkarıldı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ folder no longer exists and was removed from the list."
          }
        }
      }
    },
    "%@ klasörü zaten var.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ folder already exists."
          }
        }
      }
    },
    "%@ klasöründeki oturum cevabını tamamladı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session in %@ finished its response."
          }
        }
      }
    },
    "%@ klasöründeki oturum devam etmek için iznini bekliyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session in %@ is waiting for your permission to continue."
          }
        }
      }
    },
    "%@ klonu Claude uygulamasının verileriyle çalışıyor. Kapatıp Lanes'ten aç.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ clone is running with the Claude app's data. Quit it and open it from Lanes."
          }
        }
      }
    },
    "%@ klonu Lanes dışından açıldı ve Claude uygulamasının verileriyle çalışıyor. Kapatıp Lanes'ten aç.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ clone was opened outside Lanes and is running with the Claude app's data. Quit it and open it from Lanes."
          }
        }
      }
    },
    "%@ klonu hazır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ clone is ready."
          }
        }
      }
    },
    "%@ klonu olmadığı için Claude'un kendisiyle açılıyor. Klonu Sağlık sayfasından yeniden oluşturabilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no clone, so it's opening with Claude itself. You can rebuild the clone from the Health page."
          }
        }
      }
    },
    "%@ kopyası": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ copy"
          }
        }
      }
    },
    "%@ limit sonrası dinlendiği için yerine %@ seçildi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ was chosen because %1$@ is resting after hitting its limit."
          }
        }
      }
    },
    "%@ saatine kadar dinleniyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resting until %@."
          }
        }
      }
    },
    "%@ saatine kadar dinleniyor. Bağlantılar %@ hesabına gidiyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resting until %1$@. Links go to %2$@."
          }
        }
      }
    },
    "%@ sahnesi silinsin mi?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete scene %@?"
          }
        }
      }
    },
    "%@ sahnesinde açık pencere yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scene %@ has no open windows."
          }
        }
      }
    },
    "%@ sahnesinde hesap yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scene %@ has no accounts."
          }
        }
      }
    },
    "%@ sekmesine geç": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to %@ Tab"
          }
        }
      }
    },
    "%@ sürümünden %@ sürümüne. Klonlar bir sonraki açılışta yenilenir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From version %1$@ to %2$@. Clones update at next launch."
          }
        }
      }
    },
    "%@ tek başına olmaz. ⌘, ⌥ ya da ⌃ ile birlikte bas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can't be used alone. Press it together with ⌘, ⌥, or ⌃."
          }
        }
      }
    },
    "%@ uygulamasını çıkar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit %@"
          }
        }
      }
    },
    "%@ yeniden kullanılabilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is available again."
          }
        }
      }
    },
    "%@ yeniden kullanımda.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is back in use."
          }
        }
      }
    },
    "%@ zaten %@ hesabına bağlı. Önce oradan çıkar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is already assigned to %2$@. Remove it there first."
          }
        }
      }
    },
    "%@ zaten %@ için kullanılıyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is already used for %2$@."
          }
        }
      }
    },
    "%@ · %%%lld işlemci": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld%% CPU"
          }
