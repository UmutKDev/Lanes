    "Genellikle kaldırılmış hesaplardan kalır ve giriş bilgileri içerebilir. Lanes bunları silmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Such folders are usually left over from removed accounts and may contain sign-in data. Lanes doesn't delete them."
          }
        }
      }
    },
    "Gerekenler": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requirements"
          }
        }
      }
    },
    "Gerekli": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required"
          }
        }
      }
    },
    "Geri": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        }
      }
    },
    "Geçen hafta: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last week: %@"
          }
        }
      }
    },
    "Geçen haftanın süreleri pazartesi sabahı bildirimle gelir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last week's times arrive as a notification on Monday morning."
          }
        }
      }
    },
    "Giriş Claude'un penceresinde yapılır, Lanes giriş bilgilerini görmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You sign in within Claude's window, so Lanes doesn't see your credentials."
          }
        }
      }
    },
    "Giriş bağlantıları yönlendirilmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in links aren't routed."
          }
        }
      }
    },
    "Giriş bağlantısı": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in link"
          }
        }
      }
    },
    "Giriş bağlantısı iletilmedi. Bağlantıları artık Claude açacak, girişi yeniden dene.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in link wasn't forwarded. Claude will open these links from now on, so try signing in again."
          }
        }
      }
    },
    "Giriş bilgileri ve sohbetler dosyaya girmez. İçe aktarma yalnız eksik hesapları ve sahneleri ekler.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in data and chats aren't included in the file. Importing only adds missing accounts and scenes."
          }
        }
      }
    },
    "Giriş ve OAuth bağlantıları hiçbir zaman yönlendirilmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in and OAuth links are never routed."
          }
        }
      }
    },
    "Giriş, OAuth ve tanınmayan bağlantılar yönlendirilmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in, OAuth, and unrecognized links aren't routed."
          }
        }
      }
    },
    "Giriş, ayarlar ve sohbetler kalır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in, settings, and chats are kept."
          }
        }
      }
    },
    "Girişler ve sohbetler kalır. Claude uygulamasının kendi hesabı açık kalır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-ins and chats are kept. The Claude app's own account stays signed in."
          }
        }
      }
    },
    "Girişlerin çalışması için bu bağlantıları Claude'un açması gerekir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude must open these links for sign-in to work."
          }
        }
      }
    },
    "Girişlerine ve sohbetlerine dokunmaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doesn't touch your sign-ins or chats."
          }
        }
      }
    },
    "Git (Command Line Tools)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Git (Command Line Tools)"
          }
        }
      }
    },
    "GitHub'a yalnız Lanes'in sürümü gider.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the Lanes version number is sent to GitHub."
          }
        }
      }
    },
    "Gizlenen hesaplar kapanmaz. Sekmeli mod açıkken bu ayar kullanılmaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden accounts don't quit. This setting doesn't apply in tabbed mode."
          }
        }
      }
    },
    "Gizlilik": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        }
      }
    },
    "Google ya da Apple yerine e-posta adresinle devam et.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with your email address instead of Google or Apple."
          }
        }
      }
    },
    "Gri": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gray"
          }
        }
      }
    },
    "Görünüm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance"
          }
        }
      }
    },
    "Gün": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day"
          }
        }
      }
    },
    "Gün seçilmezse her gün uyar. 22:00–02:00 gibi bir aralık gece yarısını geçer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If no days are selected, it alerts every day. A range like 22:00–02:00 crosses midnight."
          }
        }
      }
    },
    "Gün seçmezsen her gün açılır. Mac o saatte uykudaysa sahne, iki saat içinde uyanırsa açılır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don't pick days, it opens every day. If your Mac is asleep at that time, the scene opens if it wakes within two hours."
          }
        }
      }
    },
    "Güncelle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update"
          }
        }
      }
    },
    "Güncelleme denetimi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update check"
          }
        }
      }
    },
    "Güncellemeler": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates"
          }
        }
      }
    },
    "Güncellemeler GitHub'dan denetlenir, imza yüklemeden önce doğrulanır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates are checked on GitHub and signatures are verified before installing."
          }
        }
      }
    },
    "Güncellemeleri Denetle…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates…"
          }
        }
      }
    },
    "Güncellemeleri kendiliğinden denetle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically check for updates"
          }
        }
      }
    },
    "Günler": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days"
          }
        }
      }
    },
    "Günlük süre hatırlatması": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily time reminder"
          }
        }
      }
    },
    "Günlüğü Temizle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear Log"
          }
        }
      }
    },
    "Güvenlik": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security"
          }
        }
      }
    },
    "Harf": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Letter"
          }
        }
      }
    },
    "Hazır": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready"
          }
        }
      }
    },
    "Hedef hesap yok, iletilmedi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No target account; not forwarded."
          }
        }
      }
    },
    "Henüz bağlantı gelmedi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No links yet"
          }
        }
      }
    },
    "Henüz hesap yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No accounts yet."
          }
        }
      }
    },
    "Henüz sahne yok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No scenes yet"
          }
        }
      }
    },
    "Her Claude'un hangi hesaba ait olduğunu bulmak için.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To find out which account each Claude belongs to."
          }
        }
      }
    },
    "Her bağlantı": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every link"
          }
        }
      }
    },
    "Her hesabın .claude.json dosyasından okunur. Giriş anahtarları Anahtar Zinciri'nde durur ve okunmaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from each account's .claude.json file. Sign-in keys stay in Keychain and aren't read."
          }
        }
      }
    },
    "Her hesap ayrı bir Claude": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each account is its own Claude"
          }
        }
      }
    },
    "Her hesap bir şerit: iş, kişisel ya da her müşteri için bir tane. Ad ve renk seçer, Claude'da bir kez giriş yaparsın.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each account is a lane: work, personal, or one per client. Pick a name and color, then sign in to Claude once."
          }
        }
      }
    },
    "Her hesap için Claude.app'in bir kopyası.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy of Claude.app for each account."
          }
        }
      }
    },
    "Her şey yolunda": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything looks good"
          }
        }
      }
    },
    "Her şeyi ara…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search everything…"
          }
        }
      }
    },
    "Hesabı Aç": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Account"
          }
        }
      }
    },
    "Hesabı Dinlenmeye Al": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest Account"
          }
        }
      }
    },
    "Hesabı Kaldır…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Account…"
          }
        }
      }
    },
    "Hesabı belirtilen saat kadar dinlenmeye alır. Bağlantılar bu sürede aynı türdeki başka bir hesaba gider. 0 saat dinlenmeyi bitirir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rests the account for the given number of hours. Links go to another account of the same type meanwhile. 0 hours ends the rest."
          }
        }
      }
    },
    "Hesabı listelerden ve ⌘1-9'dan kaldırır. Giriş ve veriler silinmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the account from lists and ⌘1-9. Sign-in and data aren't deleted."
          }
        }
      }
    },
    "Hesabı listelere ve ⌘1-9'a geri getirir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings the account back to the lists and ⌘1-9."
          }
        }
      }
    },
    "Hesabı Çoğalt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate Account"
          }
        }
      }
    },
    "Hesabın kendi %@ öğesi var": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account has its own %@"
          }
        }
      }
    },
    "Hesabın klasörü olmadan, Claude uygulamasının verileriyle çalışıyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running on the Claude app's data, without the account's folder."
          }
        }
      }
    },
    "Hesabın klasörü yerinde kalır: %@. Claude kopyası Çöp Sepeti'ne taşınır. Hesabı yeniden eklersen boş bir klasörle başlar ve Claude'a yeniden giriş yapman gerekir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account's folder stays in place: %@. The Claude copy moves to the Trash. If you add the account again, it starts with an empty folder and you'll need to sign in to Claude again."
          }
        }
      }
    },
    "Hesabın settings.json dosyası okunmaz. Kanca, Claude Code'un verisini okumadan atar ve bir olay dosyasına yalnız hesabı, olayı, terminal adını ve proje yolunu yazar; Lanes bu dosyayı bildirimi gösterince siler. Özellik kapatılınca klasör silinir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account's settings.json file is not read. The hook fires without reading Claude Code's data and writes only the account, event, terminal name and project path to an event file; Lanes deletes that file once it shows the notification. The folder is deleted when the feature is turned off."
          }
        }
      }
    },
    "Hesap": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        }
      }
    },
    "Hesap Ekle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Account"
          }
        }
      }
    },
    "Hesap Ekle ile ilk hesabını ekle. Lanes, Claude uygulamasına ve giriş bilgilerine dokunmaz. Pencereyi kapatınca menü çubuğunda çalışmaya devam eder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Add Account to add your first account. Lanes doesn't touch the Claude app or your sign-in details. When you close the window, it keeps running in the menu bar."
          }
        }
      }
    },
    "Hesap Ekle…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Account…"
          }
        }
      }
    },
    "Hesap Haritası": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account Map"
          }
        }
      }
    },
    "Hesap Haritası'nda bu hesaba yönlenen bağlantı yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No links in the Account Map route to this account."
          }
        }
      }
    },
    "Hesap Sayfası": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account Page"
          }
        }
      }
    },
    "Hesap adı yerine sıra numarası da yazılabilir: lanes://open?account=2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also use the account's position in the list instead of its name: lanes://open?account=2"
          }
        }
      }
    },
    "Hesap adı, klasör ya da bağlantı içermez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contains no account names, folders or links."
          }
        }
      }
    },
    "Hesap ara": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search Accounts"
          }
        }
      }
    },
    "Hesap açık olmalı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account must be open."
          }
        }
      }
    },
    "Hesap açıkken klon yenilenemez. Önce hesabı kapat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't refresh the clone while the account is open. Close the account first."
          }
        }
      }
    },
    "Hesap bulunamadı": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Account Found"
          }
        }
      }
    },
    "Hesap klasörleri": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account folders"
          }
        }
      }
    },
    "Hesap klasörlerini Lanes oluşturur, içine Claude yazar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanes creates the account folders; Claude writes into them."
          }
        }
      }
    },
    "Hesap klasörlerinin boyutu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size of account folders"
          }
        }
      }
    },
    "Hesap klasörlerinin içini de açmaz; tek istisna aşağıdaki Claude Code hesap adıdır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It doesn't look inside account folders either; the only exception is the Claude Code account name below."
          }
        }
      }
    },
    "Hesap listesi %@ dosyasına yazıldı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account list written to %@."
          }
        }
      }
    },
    "Hesap listesi kaydedilemedi: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the account list: %@"
          }
        }
      }
    },
    "Hesap listesi okunamadı, yedekten geri yüklendi. Okunamayan dosya aynı klasörde başka bir adla saklandı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the account list, so it was restored from the backup. The unreadable file was kept in the same folder under another name."
          }
        }
      }
    },
    "Hesap listesi okunamadı: %@ Dosya silinmez, ilk kayıtta aynı klasörde başka bir adla saklanır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the account list: %@ The file isn't deleted; on the first save it's kept in the same folder under another name."
          }
        }
      }
    },
    "Hesap listesi profiles.json'da, yedeği profiles.backup.json'da durur. Lanes hesap klasörlerine yalnız Araç Kutusu için bağlantı (symlink) ekler. cli-accounts.tsv, lanes komut satırı aracı için yalnız hesap adlarını, kimliklerini ve klasör yollarını tutar; araç kurulursa ~/.local/bin/lanes dosyasına yazılır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account list is in profiles.json, with its backup in profiles.backup.json. The only things Lanes adds to account folders are links (symlinks) for the Toolbox. cli-accounts.tsv holds only account names, IDs and folder paths for the lanes command-line tool; the tool, if installed, is written to ~/.local/bin/lanes."
          }
        }
      }
    },
    "Hesap listesi ve hesap klasörleri": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account list and account folders"
          }
        }
      }
    },
    "Hesap listesini taşı": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Account List"
          }
        }
      }
    },
    "Hesap rengi çerçevesi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account Color Frame"
          }
        }
      }
    },
    "Hesap türü": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account Type"
          }
