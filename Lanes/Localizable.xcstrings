    "Sürüm %@ kurulu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ is installed."
          }
        }
      }
    },
    "Sürümleri, hesapları ve klasör yollarını içerir. Hesap adları yerine numara, ev klasörü yerine ~ yazar; hesap klasörlerinin içi okunmaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes versions, accounts and folder paths. Account names are replaced with numbers and the home folder with ~; the contents of account folders are not read."
