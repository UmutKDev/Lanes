          "stringUnit": {
            "state": "translated",
            "value": "MCP servers"
          }
        }
      }
    },
    "MCP sunucularında kaydedilmemiş değişiklik var. Önce kaydet, sonra ekip paketini içe aktar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP servers have unsaved changes. Save first, then import the team pack."
          }
        }
      }
    },
    "Mavi": {
      "localizations": {
        "en": {
