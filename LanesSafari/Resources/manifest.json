{
  "manifest_version": 3,
  "default_locale": "tr",
  "name": "__MSG_extensionName__",
  "short_name": "Lanes",
  "description": "__MSG_extensionDescription__",
  "version": "1.1.1",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["lib/core.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "19": "icons/toolbar-19.png",
      "32": "icons/toolbar-32.png",
      "38": "icons/toolbar-38.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "__MSG_commandOpen__"
    },
    "switch-next": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "__MSG_commandNext__"
    },
    "switch-previous": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "__MSG_commandPrevious__"
    }
  },
  "permissions": ["cookies", "storage", "tabs", "contextMenus", "nativeMessaging"],
  "host_permissions": ["https://claude.ai/*"]
}
